.modals .student-achievement
    width 540px
    max-width calc(100vw - 32px)
    max-height calc(100dvh - 32px)
    overflow-y auto
    border 1px solid alpha(#e88eff, 0.4)
    border-radius 8px
    box-shadow 0 0 60px alpha(#e88eff, 0.12)

    .content
        padding-top 64px

    .student-eyebrow
        color #e88eff
        font-size 0.65rem
        font-weight 700
        letter-spacing 0.18em

    .student-spark
        color #e88eff
        font-size 3rem
        line-height 1.5
        text-shadow 0 0 24px alpha(#e88eff, 0.6)

    .title
        font-size clamp(2rem, 7vw, 2.8rem)

    .student-name
        margin-top 1.2em
        font-weight 700
        overflow-wrap break-word

    .student-description
        margin-top 1.5em
        font-size 0.8rem

    button:focus-visible
        outline 2px solid #e88eff
        outline-offset 4px

    &.is-displayed .student-spark
        animation student-reveal 0.6s ease-out both

@keyframes student-reveal
    from
        opacity 0
        transform scale(0.7) rotate(-20deg)
    to
        opacity 1
        transform scale(1) rotate(0)

@media (prefers-reduced-motion reduce)
    .modals .student-achievement.is-displayed .student-spark
        animation none
